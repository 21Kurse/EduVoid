# EduVoid environment variables. Copy to .env.local and fill in.
# Never commit .env.local. Keys are server-side only (AGENTS.md §13.9).

# ── LLM (owner supplies exact values at GATE G1 — do not guess the model ID) ──
# Provider-agnostic OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
# Role-based routing (AGENTS.md §3). Default: same model for all roles.
# Override planner/verifier with a stronger model only if the G1 spike demands it.
LLM_MODEL_PLANNER=
LLM_MODEL_GENERATOR=
LLM_MODEL_VERIFIER=
LLM_MODEL_GRADER=

# ── Search (default provider: Tavily, AGENTS.md §3) ──
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
