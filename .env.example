# EduVoid environment variables. Copy to .env.local and fill in.
# Never commit .env.local. Keys are server-side only (AGENTS.md §13.9).

# ── LLM (owner supplies exact values at GATE G1 — do not guess the model ID) ──
# Provider-agnostic OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
# Role-based routing (AGENTS.md §3). LLM_MODEL_DEFAULT applies to all roles;
# per-role vars override it. Set at GATE G1 — never guess the model ID.
LLM_MODEL_DEFAULT=
LLM_MODEL_PLANNER=
LLM_MODEL_GENERATOR=
LLM_MODEL_VERIFIER=
LLM_MODEL_GRADER=

# ── Search (default provider: Tavily, AGENTS.md §3) ──
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
